#!/bin/bash

set -euo pipefail

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    echo "Waiting for instruqt bootstrap to complete"
    sleep 1
done

REPO=/opt/ld/ai-configs-intro
REPO_URL="https://github.com/launchdarkly-labs/ld-workshop-ai-configs-intro.git"
REPO_REF="${REPO_REF:-main}"

# 0. Sync the baked repo clone to the current commit (see DECISIONS.md,
#    2026-10-06). Tracked files only; app/.env is gitignored.
echo "Syncing ${REPO} to ${REPO_REF}"
if git -C "${REPO}" remote set-url origin "${REPO_URL}" \
   && git -C "${REPO}" fetch --depth 1 origin "${REPO_REF}" \
   && git -C "${REPO}" reset --hard FETCH_HEAD; then
    echo "Repo at $(git -C "${REPO}" rev-parse --short HEAD)"
else
    echo "WARNING: could not sync ${REPO}; continuing with the baked copy at $(git -C "${REPO}" rev-parse --short HEAD)"
fi

cd /opt/ld/terraform-ld-student
echo "sandbox_id = \"${_SANDBOX_ID}\"" > terraform.tfvars
terraform apply -auto-approve
export LD_PROJECT_KEY="$(terraform output -json | jq -r '.students.value[0].project_key')"
echo "" >> ~/.profile
echo "export LD_PROJECT_KEY=\"$LD_PROJECT_KEY\"" >> ~/.profile
echo "" >> ~/.bashrc
echo "export LD_PROJECT_KEY=\"$LD_PROJECT_KEY\"" >> ~/.bashrc

export LD_CLIENT_KEY=$(curl -s -X GET \
  'https://app.launchdarkly.com/api/v2/projects/'${LD_PROJECT_KEY}'/environments/test' \
  -H 'Authorization: '${LAUNCHDARKLY_ACCESS_TOKEN}'' | jq -r ._id)
echo "export LD_CLIENT_KEY=${LD_CLIENT_KEY}" >> ~/.profile
echo "export LD_CLIENT_KEY=${LD_CLIENT_KEY}" >> ~/.bashrc

export LD_SDK_KEY=$(curl -s -X GET \
  'https://app.launchdarkly.com/api/v2/projects/'${LD_PROJECT_KEY}'/environments/test' \
  -H 'Authorization: '${LAUNCHDARKLY_ACCESS_TOKEN}'' | jq -r .apiKey)
echo "export LD_SDK_KEY=${LD_SDK_KEY}" >> ~/.profile
echo "export LD_SDK_KEY=${LD_SDK_KEY}" >> ~/.bashrc

# Mint a scoped API token restricted to this project only. The operator's
# LAUNCHDARKLY_ACCESS_TOKEN stays out of the participant's env; this
# per-lab token lives in .env for app-side REST calls. Blast radius is
# bounded by the project scope; the project is destroyed at cleanup. The
# bootstrap creates a `<project>-admin` custom role; the operator token may
# only mint tokens from custom roles (an inline role returns 403).
CUSTOM_ROLE_ID=$(curl -s https://app.launchdarkly.com/api/v2/roles/${LD_PROJECT_KEY}-admin \
     -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
     -H "Content-Type: application/json" | jq -r '._id')

export LD_API_TOKEN=$(curl -fsS -X POST https://app.launchdarkly.com/api/v2/tokens \
     -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
     -H "Content-Type: application/json" \
     -d '{
  "name": "Lab token: '${LD_PROJECT_KEY}'",
  "customRoleIds": [
    "'${CUSTOM_ROLE_ID}'"
  ],
  "serviceToken": true
}' | jq -r '.token')
echo "export LD_API_TOKEN=${LD_API_TOKEN}" >> ~/.profile
echo "export LD_API_TOKEN=${LD_API_TOKEN}" >> ~/.bashrc

APP_ENV="${REPO}/app/.env"
sed -i 's|^LD_SDK_KEY=.*|LD_SDK_KEY='"${LD_SDK_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_CLIENT_KEY=.*|LD_CLIENT_KEY='"${LD_CLIENT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_PROJECT_KEY=.*|LD_PROJECT_KEY='"${LD_PROJECT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_API_TOKEN=.*|LD_API_TOKEN='"${LD_API_TOKEN}"'|g' "$APP_ENV"
sed -i 's|^AWS_REGION=.*|AWS_REGION='"${AWS_REGION}"'|g' "$APP_ENV"

# First stop, then start the service. "restart" simply sends a "SIGHUP" 
# which the app doesn't handle, so the new env vars aren't picked up until 
# we do a full stop/start.
service togglewear stop
service togglewear start
