#!/bin/sh

# Validates the prompt experiment is set up and its first iteration has been
# started (or already stopped after promoting a winner).
#
# Verified against the live API 2026-10-06:
#   * GET .../ai-configs/otto-assistant returns variations with a `key` field.
#   * GET .../environments/test/experiments/otto-prompt-experiment returns
#     `currentIteration.status` = not_started | running | stopped. The
#     experiment key is derived from the name "Otto Prompt Experiment".

API="https://app.launchdarkly.com/api/v2"
AUTH="Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}"

# 1. The otto-recommender contender variation exists.
CONFIG=$(curl -fsS -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant" \
  -H "$AUTH" -H 'LD-API-Version: beta')

CONTENDER=$(printf '%s' "$CONFIG" | jq -r '.variations[]? | select(.key=="otto-recommender") | .key // ""')
if [ -z "$CONTENDER" ]; then
  fail-message "The Otto (Recommender) variation hasn't been created yet. On the Otto Assistant config, click Add variation, name it exactly Otto (Recommender) (the key becomes otto-recommender), and use the prompt from the lab."
  exit 1
fi

# 2. The otto-prompt-experiment experiment exists.
EXPERIMENT=$(curl -s -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/environments/test/experiments/otto-prompt-experiment" \
  -H "$AUTH" -H 'LD-API-Version: beta')

EXP_KEY=$(printf '%s' "$EXPERIMENT" | jq -r '.key // ""')
if [ -z "$EXP_KEY" ]; then
  fail-message "The Otto Prompt Experiment doesn't exist in the Test environment yet. On the Experiments page, click Create experiment, name it exactly Otto Prompt Experiment, and complete the design from the lab."
  exit 1
fi

# 3. The first iteration has been started.
STATUS=$(printf '%s' "$EXPERIMENT" | jq -r '.currentIteration.status // ""')
case "$STATUS" in
  running|stopped) ;;
  *)
    fail-message "The experiment exists but hasn't been started (status: ${STATUS:-unknown}). Finish the design so the banner reads Experiment design is complete, click Save, then click Start → Start experiment."
    exit 1
    ;;
esac

exit 0
