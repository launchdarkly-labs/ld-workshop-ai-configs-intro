#!/bin/bash

# Evaluate (L2) track-level setup.
#
# Bootstraps a fresh LaunchDarkly project for the learner, then materializes
# Otto's post-Build state by applying Build's solve modules (challenges 01,
# 02, 03, 05, 06) and the Challenge-01 server.py patch. The learner arrives
# in Evaluate with the same Otto that a Build-completing learner would have:
# wired to the Config, on-brand via the brand-voice + safety-rules
# snippets, premium variation in place, monitoring view populated.

set -euo pipefail

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    echo "Waiting for instruqt bootstrap to complete"
    sleep 1
done

REPO=/opt/ld/ai-configs-intro
REPO_URL="https://github.com/launchdarkly-labs/ld-workshop-ai-configs-intro.git"
REPO_REF="${REPO_REF:-main}"

# 0. Sync the baked repo clone to the current commit. The VM image bakes a
#    shallow clone at build time and nothing else ever pulls it, so without
#    this every Terraform module, server paste and traffic script in the lab
#    is frozen at image-bake time (the first live run on 2026-10-06 ran a
#    month-old clone). Tracked files only: app/.env is gitignored and the
#    Challenge-01 server.py patch is re-applied in step 5 below. If GitHub is
#    unreachable we carry on with the baked copy rather than fail the lab.
echo "Syncing ${REPO} to ${REPO_REF}"
if git -C "${REPO}" remote set-url origin "${REPO_URL}" \
   && git -C "${REPO}" fetch --depth 1 origin "${REPO_REF}" \
   && git -C "${REPO}" reset --hard FETCH_HEAD; then
    echo "Repo at $(git -C "${REPO}" rev-parse --short HEAD)"
else
    echo "WARNING: could not sync ${REPO}; continuing with the baked copy at $(git -C "${REPO}" rev-parse --short HEAD)"
fi

# 1. Bootstrap the LD project.
cd /opt/ld/terraform-ld-student
echo "sandbox_id = \"${_SANDBOX_ID}\"" > terraform.tfvars
terraform apply -auto-approve
export LD_PROJECT_KEY="$(terraform output -json | jq -r '.students.value[0].project_key')"
{
    echo ""
    echo "export LD_PROJECT_KEY=\"$LD_PROJECT_KEY\""
} >> ~/.profile
echo "export LD_PROJECT_KEY=\"$LD_PROJECT_KEY\"" >> ~/.bashrc

# 2. Pull SDK + client keys from the test environment.
export LD_CLIENT_KEY=$(curl -s -X GET \
  "https://app.launchdarkly.com/api/v2/projects/${LD_PROJECT_KEY}/environments/test" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" | jq -r ._id)
echo "export LD_CLIENT_KEY=${LD_CLIENT_KEY}" >> ~/.profile
echo "export LD_CLIENT_KEY=${LD_CLIENT_KEY}" >> ~/.bashrc

export LD_SDK_KEY=$(curl -s -X GET \
  "https://app.launchdarkly.com/api/v2/projects/${LD_PROJECT_KEY}/environments/test" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" | jq -r .apiKey)
echo "export LD_SDK_KEY=${LD_SDK_KEY}" >> ~/.profile
echo "export LD_SDK_KEY=${LD_SDK_KEY}" >> ~/.bashrc

# Mint a scoped API token restricted to this project only. See note in
# Build's track-level setup-workstation for the security rationale.
CUSTOM_ROLE_ID=$(curl -s https://app.launchdarkly.com/api/v2/roles/${LD_PROJECT_KEY}-admin \
     -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
     -H "Content-Type: application/json" | jq -r '._id')

export LD_API_TOKEN=$(curl -fsS -X POST https://app.launchdarkly.com/api/v2/tokens \
     -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
     -H "Content-Type: application/json" \
     -d '{
  "name": "Lab token: '${LD_PROJECT_KEY}'",
  "customRoleIds": [
    "'${CUSTOM_ROLE_ID}'"
  ],
  "serviceToken": true
}' | jq -r '.token')
echo "export LD_API_TOKEN=${LD_API_TOKEN}" >> ~/.profile
echo "export LD_API_TOKEN=${LD_API_TOKEN}" >> ~/.bashrc

# 3. Update the app's .env so togglewear.service picks up real values.
APP_ENV="${REPO}/app/.env"
sed -i 's|^LD_SDK_KEY=.*|LD_SDK_KEY='"${LD_SDK_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_CLIENT_KEY=.*|LD_CLIENT_KEY='"${LD_CLIENT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_PROJECT_KEY=.*|LD_PROJECT_KEY='"${LD_PROJECT_KEY}"'|g' "$APP_ENV"
sed -i 's|^LD_API_TOKEN=.*|LD_API_TOKEN='"${LD_API_TOKEN}"'|g' "$APP_ENV"
sed -i 's|^AWS_REGION=.*|AWS_REGION='"${AWS_REGION}"'|g' "$APP_ENV"

# 4. Materialize the post-Build state. Order matters: ch01 creates the AI
#    Config, ch02 updates the prompt, ch03 adds snippets and refactors,
#    ch05 adds the premium variation + targeting rule, ch06 seeds the
#    monitoring view with traffic. Build's ch04 is a quiz (no terraform)
#    and ch07 (trust-but-verify) is what Evaluate's own ch07 lifts, so
#    we deliberately skip both.
for ch in challenge-01 challenge-02 challenge-03 challenge-05 challenge-06; do
    cd "${REPO}/terraform/${ch}"
    echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
    terraform init -input=false
    terraform apply -auto-approve
done

# 5. Apply Challenge-01's server.py patch so the running app's /chat
#    handler is wired to Otto (rather than the BEFORE-state stub).
python3 "${REPO}/terraform/challenge-01/patch-server.py"

# First stop, then start the service. "restart" simply sends a "SIGHUP" 
# which the app doesn't handle, so the new env vars aren't picked up until 
# we do a full stop/start.
service togglewear stop
service togglewear start
