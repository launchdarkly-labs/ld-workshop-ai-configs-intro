#!/bin/sh

# Validates the learner has built the brand-voice judge end-to-end.
#
# The judge's key is deterministic again: the Create config dialog has an
# "Edit config key" affordance and the assignment has the learner set it to
# otto-brand-voice-judge (verified in the live UI 2026-10-06). Everything
# below keys off that.
#
# Assertions:
#   1. otto-brand-voice-judge exists and is in judge mode.
#   2. Its latest variation's system message references the brand-voice
#      snippet ({{snippet.brand-voice#N}}).
#   3. The judge is attached to otto-born (judgeConfiguration on the latest
#      variation version).
#   4. server.py has the brand-voice judge integration.
#
# Not asserted: the otto-brand-voice-score metric (setup pre-creates it) and
# the desired direction (soft; wrong direction doesn't break later labs).

API="https://app.launchdarkly.com/api/v2"
AUTH="Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}"

JUDGE=$(curl -s -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-brand-voice-judge" \
  -H "$AUTH" -H 'LD-API-Version: beta')

if [ "$(printf '%s' "$JUDGE" | jq -r '.key // "null"')" = "null" ]; then
  fail-message "There's no config with key **otto-brand-voice-judge** yet. In **Create config**, choose **Judge**, click **Edit config key**, and set the key to \`otto-brand-voice-judge\` before you click **Generate judge**. (If you already generated one under a different key, delete it and generate again.)"
  exit 1
fi

if [ "$(printf '%s' "$JUDGE" | jq -r '.mode // ""')" != "judge" ]; then
  fail-message "**otto-brand-voice-judge** exists but isn't in **Judge** mode. Configs can't change mode after creation — delete it and create it again with **Judge** selected."
  exit 1
fi

SYSTEM_MSG=$(printf '%s' "$JUDGE" | jq -r '[.variations[]?] | max_by(.version) | .messages[]? | select(.role=="system") | .content' | head -c 8192)
if ! echo "$SYSTEM_MSG" | grep -q 'snippet.brand-voice'; then
  fail-message "The judge's **Default** variation doesn't reference the **Brand voice** snippet. Clear the System message, click **Load snippet**, choose **Brand voice**, paste the rubric below it, then **Review and save**."
  exit 1
fi

BORN=$(curl -s -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant/variations/otto-born" \
  -H "$AUTH" -H 'LD-API-Version: beta')
ATTACHED=$(printf '%s' "$BORN" | jq -r '(.items // []) | max_by(.version) | .judgeConfiguration.judges // [] | map(select(.judgeConfigKey == "otto-brand-voice-judge")) | length')
if [ "$ATTACHED" -lt 1 ]; then
  fail-message "**Otto Brand Voice Judge** isn't attached to **Otto (Born)** yet. On **Otto Assistant**, expand Otto (Born), click **+ Add judges**, tick **Otto Brand Voice Judge**, click **Add 1 judge**, then **Review and save**."
  exit 1
fi

if ! grep -q 'otto-brand-voice-judge' /opt/ld/ai-configs-intro/app/server.py; then
  fail-message "Your server code doesn't invoke the brand-voice judge yet. Paste the judge-invocation block from the assignment into \`server.py\` immediately below the Challenge 07 marker comment."
  exit 1
fi

exit 0
