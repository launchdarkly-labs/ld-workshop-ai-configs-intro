#!/bin/sh

# Per-challenge setup for ch08 (adaptive switching).
#
# Applies the evaluate-08 module, which flips Otto's fallthrough to
# otto-formal so real /chat traffic gets the off-brand variation and
# the brand-voice judge starts scoring it low. Then swaps in the
# realchat traffic generator so the judge actually fires.
#
# The learner's job is to wire the adaptive loop in server.py; once
# they do, the loop sees the low scores accumulating and flips the
# fallthrough back to otto-born.

set -e

# A running ch06 experiment owns the Default rule and makes the fallthrough
# patch below 409. Stop it (shipping Otto (Recommender)) if it's still going.
python3 /opt/ld/ai-configs-intro/terraform/evaluate-06/setup-experiment.py \
  --project "${LD_PROJECT_KEY}" --stop-if-running || true

# Likewise, if the learner clicked Check on ch07 while the guarded rollout was
# still in progress (the check passes on an active measuredRollout), the
# release owns the Default rule and the fallthrough patch below returns 500
# for as long as it runs. Stop it, rolling back to the original variation,
# exactly like the UI's Stop release -> Roll back.
#
# Verified with an API token on 2026-10-07: the `releaseId` the instruction
# wants is the PARENT release id from
#   GET /internal/projects/{proj}/flags/otto-assistant/environments/test/releases
# (items[].id, whose phases[] carry the automated-release ids and statuses),
# NOT the automated-release id from .../automated-releases (that returns
# "environment release not found").
API="https://app.launchdarkly.com/api/v2/projects/${LD_PROJECT_KEY}"
INT="https://app.launchdarkly.com/internal/projects/${LD_PROJECT_KEY}"
AUTH="Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}"
RELEASES=$(curl -fsS -X GET \
  "${INT}/flags/otto-assistant/environments/test/releases" \
  -H "$AUTH" -H 'LD-API-Version: beta' 2>/dev/null || echo '{}')
ACTIVE_RELEASE_ID=$(printf '%s' "$RELEASES" | jq -r '[.items[]? | select(any(.phases[]?; .status == "in_progress"))] | .[0].id // empty')
if [ -n "$ACTIVE_RELEASE_ID" ]; then
  curl -fsS -X PATCH "${API}/ai-configs/otto-assistant/targeting" \
    -H "$AUTH" -H 'LD-API-Version: beta' \
    -H 'Content-Type: application/json' \
    --data-raw "$(jq -n --arg id "$ACTIVE_RELEASE_ID" '{
      environmentKey: "test",
      comment: "Evaluate ch08 setup: stop the ch07 guarded rollout before putting Otto in a bad state",
      instructions: [{ kind: "stopAutomatedRelease", releaseId: $id, finalizationBehavior: "rollBackCurrentPhase", fallthrough: true }]
    }')" > /dev/null \
    && echo "Stopped in-progress guarded release ${ACTIVE_RELEASE_ID} (rolled back)." \
    || echo "(could not stop release ${ACTIVE_RELEASE_ID}; continuing)"
  # LD needs a moment to finalize the rollback before the fallthrough accepts
  # a plain variation again (the Terraform step also retries).
  sleep 10
fi

cd /opt/ld/ai-configs-intro/terraform/evaluate-08
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve

# Swap to realchat traffic so the brand-voice judge sees real Otto
# responses to score.
pkill -f background_traffic.py 2>/dev/null || true
pkill -f experiment_traffic.py 2>/dev/null || true

if ! pgrep -f realchat_traffic.py > /dev/null; then
  nohup /opt/ld/ai-configs-intro/app/.venv/bin/python3 \
    /opt/ld/ai-configs-intro/traffic-generator/realchat_traffic.py \
    > /var/log/togglewear-realchat.log 2>&1 &
fi

exit 0
