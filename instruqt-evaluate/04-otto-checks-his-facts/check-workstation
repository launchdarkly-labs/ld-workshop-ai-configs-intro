#!/bin/sh

# Validates the learner has built the product-claim accuracy judge.
#
# The judge's key is deterministic: the Create config dialog's "Edit config
# key" affordance lets the learner set otto-claim-accuracy-judge (verified in
# the live UI 2026-10-06). Snippet keys are derived from the snippet name, so
# "Product catalog" -> product-catalog.
#
# Assertions:
#   1. product-catalog snippet exists.
#   2. otto-claim-accuracy-judge exists in judge mode.
#   3. Its latest variation's system message references the snippet.
#   4. The judge is attached to otto-born.
#   5. server.py has the claim-accuracy judge integration.
#
# Not asserted: the otto-claim-accuracy-score metric (setup pre-creates it).

API="https://app.launchdarkly.com/api/v2"
AUTH="Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}"

SNIP_STATUS=$(curl -s -o /dev/null -w '%{http_code}' \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/prompt-snippets/product-catalog" \
  -H "$AUTH" -H 'LD-API-Version: beta')
if [ "$SNIP_STATUS" != "200" ]; then
  fail-message "The product-catalog snippet doesn't exist yet. Go to Library → Snippets, click Create snippet, name it exactly Product catalog (the key is derived from the name), and paste the catalog from the lab as the body."
  exit 1
fi

JUDGE=$(curl -s -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-claim-accuracy-judge" \
  -H "$AUTH" -H 'LD-API-Version: beta')

if [ "$(printf '%s' "$JUDGE" | jq -r '.key // "null"')" = "null" ]; then
  fail-message "There's no config with key otto-claim-accuracy-judge yet. In Create config, choose Judge, click Edit config key, and set the key to otto-claim-accuracy-judge before clicking Generate judge."
  exit 1
fi

if [ "$(printf '%s' "$JUDGE" | jq -r '.mode // ""')" != "judge" ]; then
  fail-message "otto-claim-accuracy-judge exists but isn't in Judge mode. Delete it and create it again with Judge selected."
  exit 1
fi

SYSTEM_MSG=$(printf '%s' "$JUDGE" | jq -r '[.variations[]?] | max_by(.version) | .messages[]? | select(.role=="system") | .content' | head -c 8192)
if ! echo "$SYSTEM_MSG" | grep -q 'snippet.product-catalog'; then
  fail-message "The judge's Default variation doesn't reference the Product catalog snippet. Clear the System message, click Load snippet, choose Product catalog, paste the rubric below it, then Review and save."
  exit 1
fi

BORN=$(curl -s -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant/variations/otto-born" \
  -H "$AUTH" -H 'LD-API-Version: beta')
ATTACHED=$(printf '%s' "$BORN" | jq -r '(.items // []) | max_by(.version) | .judgeConfiguration.judges // [] | map(select(.judgeConfigKey == "otto-claim-accuracy-judge")) | length')
if [ "$ATTACHED" -lt 1 ]; then
  fail-message "Otto Claim Accuracy Judge isn't attached to Otto (Born) yet. On Otto Assistant, expand Otto (Born), click + Add judges, check Otto Claim Accuracy Judge, click Add 1 judge, then Review and save."
  exit 1
fi

if ! grep -q 'otto-claim-accuracy-judge' /opt/ld/ai-configs-intro/app/server.py; then
  fail-message "Your server code doesn't invoke the claim-accuracy judge yet. Paste the second judge block from the assignment into server.py immediately below the Challenge 07 marker comment."
  exit 1
fi

exit 0
