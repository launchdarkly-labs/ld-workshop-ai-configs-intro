#!/bin/sh

# Validates the learner has built a playground against the seeded dataset
# and run it at least once.
#
# Datasets, playgrounds, evaluations and runs live under the undocumented
# `/internal` REST surface (reachable with a normal API token). Shapes were
# captured from the LD web app's own traffic on 2026-10-06 — see
# instruqt-evaluate/INTERNAL-API.md.
#
# Three assertions:
#   1. The Otto Born baseline dataset exists and is ready.
#   2. At least one playground exists.
#   3. At least one evaluation run has graded rows (passed + failed > 0),
#      i.e. the learner clicked Run all and the run actually completed.

API="https://app.launchdarkly.com/internal/projects/${LD_PROJECT_KEY}"
AUTH="Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}"

DATASETS=$(curl -fsS -X GET \
  "${API}/datasets?page=1&page_size=50" \
  -H "$AUTH" -H 'LD-API-Version: beta')

DATASET_ID=$(printf '%s' "$DATASETS" | jq -r '.datasets[]? | select(.key == "otto-born-baseline" or .filename == "customer-questions.jsonl") | .id' | head -n 1)

if [ -z "$DATASET_ID" ] || [ "$DATASET_ID" = "null" ]; then
  fail-message "The Otto Born baseline dataset is missing from your project. The track setup should have uploaded it — click Skip to re-seed it."
  exit 1
fi

PLAYGROUNDS=$(curl -fsS -X GET \
  "${API}/playgrounds?sortBy=createdAt" \
  -H "$AUTH" -H 'LD-API-Version: beta')

PLAYGROUND_COUNT=$(printf '%s' "$PLAYGROUNDS" | jq -r '.items // [] | length')
if [ "$PLAYGROUND_COUNT" -lt 1 ]; then
  fail-message "You haven't created a playground yet. In the LaunchDarkly UI, switch to Agents, open Playgrounds, click New playground, and load the Otto (Born) and Otto (Premium) variations into sides A and B."
  exit 1
fi

# Every run in the project, across all playgrounds (this is the same call the
# Evaluations page makes).
RUNS=$(curl -fsS -X GET \
  "${API}/evaluations/runs?source=playground%2Capi&limit=50" \
  -H "$AUTH" -H 'LD-API-Version: beta')

RUN_COUNT=$(printf '%s' "$RUNS" | jq -r '.items // [] | length')
if [ "$RUN_COUNT" -lt 1 ]; then
  fail-message "Your playground hasn't been run yet. Select the Otto Born baseline dataset at the bottom of the playground, add the Answer Relevancy criteria, and click Run all."
  exit 1
fi

# Walk runs newest-first looking for one with graded rows. A run that hit a
# provider error has state PERMANENT_ERROR and a statusReason we can surface.
FOUND_GRADED_RUN=0
LAST_ERROR=""
# Run items (verified live 2026-10-07): {id, evaluation:{id,name,...}, dataset,
# state (PENDING | COMPLETE | PERMANENT_ERROR), rowCount, selectedRowCount,
# completedCount, failedCount, statusReason?}. The evaluation id is nested,
# not a top-level evaluationId.
for ROW in $(printf '%s' "$RUNS" | jq -r '.items[] | "\(.evaluation.id // .evaluationId // "")|\(.id)|\(.state)|\(.completedCount // 0)"'); do
  EVAL_ID=$(echo "$ROW" | cut -d'|' -f1)
  RUN_ID=$(echo "$ROW" | cut -d'|' -f2)
  STATE=$(echo "$ROW" | cut -d'|' -f3)
  COMPLETED=$(echo "$ROW" | cut -d'|' -f4)
  if [ "$STATE" = "PERMANENT_ERROR" ]; then
    LAST_ERROR=$(printf '%s' "$RUNS" | jq -r --arg id "$RUN_ID" '.items[] | select(.id == $id) | .statusReason // ""')
    continue
  fi
  if [ "$STATE" = "COMPLETE" ] && [ "${COMPLETED:-0}" -gt 0 ]; then
    FOUND_GRADED_RUN=1
    break
  fi
  # Fall back to the summary (statusCounts: total/passed/failed/error/pending).
  if [ -n "$EVAL_ID" ]; then
    SUMMARY=$(curl -fsS -X GET \
      "${API}/evaluations/${EVAL_ID}/runs/${RUN_ID}/summary" \
      -H "$AUTH" -H 'LD-API-Version: beta' 2>/dev/null || echo '{}')
    GRADED=$(printf '%s' "$SUMMARY" | jq -r '(.statusCounts.passed // 0) + (.statusCounts.failed // 0)')
    if [ "${GRADED:-0}" -gt 0 ]; then
      FOUND_GRADED_RUN=1
      break
    fi
  fi
done

if [ "$FOUND_GRADED_RUN" -ne 1 ]; then
  if [ -n "$LAST_ERROR" ]; then
    fail-message "Your run finished with an error: ${LAST_ERROR}. This usually means the playground could not reach the model provider. Make sure both columns use the Anthropic provider (not Bedrock), then click Run all again."
  else
    fail-message "Your run hasn't finished grading yet. Wait for the A output and B output columns to fill in (usually under a minute for 15 rows), then click Check again."
  fi
  exit 1
fi

exit 0
