#!/bin/sh

# Apply the full evaluate-01 module: creates the dataset (no-op if setup
# already did), builds the "Otto Born baseline" playground with Otto (Born)
# on side A and Otto (Premium) on side B, and starts one run per side
# against 15 random dataset rows. End state matches what the learner
# produces by clicking through the UI.

set -e

cd /opt/ld/ai-configs-intro/terraform/evaluate-01
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve

exit 0
