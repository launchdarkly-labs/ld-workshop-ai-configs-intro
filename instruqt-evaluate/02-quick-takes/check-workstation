#!/bin/sh

# Validates the learner has attached at least one built-in judge to the
# otto-born variation. We don't check sampling rate (operator-tunable).
#
# Verified 2026-10-06 against the live API:
#   * GET .../variations/{key} returns {items: [<version>, ...], totalCount}
#     — one entry per published version — NOT a single variation object.
#     Read judgeConfiguration off the highest version.
#   * Attached judges are stored as {judgeConfigKey: "accuracy", samplingRate}
#     using the judge config's short key. The $ld:ai:judge:accuracy string the
#     UI shows next to each judge is its evaluationMetricKey (event key).

API="https://app.launchdarkly.com/api/v2"

VAR=$(curl -fsS -X GET \
  "${API}/projects/${LD_PROJECT_KEY}/ai-configs/otto-assistant/variations/otto-born" \
  -H "Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}" \
  -H 'LD-API-Version: beta')

LATEST=$(printf '%s' "$VAR" | jq -c '(.items // []) | max_by(.version) // {}')

JUDGE_COUNT=$(printf '%s' "$LATEST" | jq -r '.judgeConfiguration.judges // [] | length')

if [ "$JUDGE_COUNT" -lt 1 ]; then
  fail-message "No judges are attached to Otto (Born) yet. In the LaunchDarkly UI, open Otto Assistant, expand the Otto (Born) variation, click + Add judges, pick at least one built-in (Accuracy, Relevance, or Toxicity), then Review and save."
  exit 1
fi

BUILT_IN_COUNT=$(printf '%s' "$LATEST" | jq -r '
  [.judgeConfiguration.judges[]? | .judgeConfigKey
   | select(. == "accuracy" or . == "relevance" or . == "toxicity")] | length')

if [ "$BUILT_IN_COUNT" -lt 1 ]; then
  fail-message "Judges are attached to Otto (Born), but none of them is a built-in. This challenge wants at least one of Accuracy, Relevance, or Toxicity."
  exit 1
fi

exit 0
