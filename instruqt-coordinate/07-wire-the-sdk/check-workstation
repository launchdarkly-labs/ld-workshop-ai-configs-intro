#!/bin/sh
API="https://app.launchdarkly.com/api/v2"
AUTH="Authorization: ${LAUNCHDARKLY_ACCESS_TOKEN}"

SERVER=/opt/ld/ai-configs-intro/app/server.py
if ! grep -q 'ai_client.agent_graph("concierge"' "$SERVER"; then
  fail-message "server.py doesn't evaluate the concierge agent graph yet. Replace the Challenge 01 Otto block (from the '# --- Challenge 01: wire Otto to /chat' comment down to, but not including, the '# --- Challenge 07 judge injects below this marker' comment) with the Concierge dispatch block from the lab, then save."
  exit 1
fi
if grep -q 'cfg = ai_client.completion_config(OTTO_CONFIG_KEY' "$SERVER"; then
  fail-message "server.py still calls Otto's completion Config directly. The Concierge block replaces that whole section; delete the old Otto block so /chat goes through the graph."
  exit 1
fi
if ! grep -q 'Coordinate 10: self-healing hook' "$SERVER"; then
  fail-message "The Concierge block in server.py is missing its 'Coordinate 10: self-healing hook' comment. Paste the block from the lab exactly as written; Challenge 10 depends on that line."
  exit 1
fi
if ! python3 -m py_compile "$SERVER" 2>/tmp/compile.err; then
  fail-message "server.py has a syntax error after the paste: $(head -c 200 /tmp/compile.err). Check the indentation of the pasted block (every line should start with four spaces)."
  exit 1
fi
# The app should answer through the graph. Give it one real question.
REPLY=$(curl -s -m 60 -X POST http://localhost:3000/chat -H 'Content-Type: application/json' \
  --data-raw '{"message":"How much is the Feature Flag Hoodie?","user_tier":"free","session_id":"check-07"}')
if ! printf '%s' "$REPLY" | jq -e '.response | length > 0' > /dev/null 2>&1; then
  fail-message "The ToggleWear app didn't return a response through the Concierge: $(printf '%s' "$REPLY" | head -c 200). Check the service log with: journalctl -u togglewear -n 50"
  exit 1
fi
exit 0
