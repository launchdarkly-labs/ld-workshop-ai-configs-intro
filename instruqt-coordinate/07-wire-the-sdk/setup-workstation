#!/bin/sh
# Coordinate ch07 setup: prepare the Terraform module so Skip is fast. Nothing
# is applied here; the learner builds the state in the UI (solve-workstation
# applies the module instead).
set -e
cd /opt/ld/ai-configs-intro/terraform/coordinate-07
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
# Real customer traffic through /chat so the graph gets exercised and the
# Evaluate-era judges keep scoring the (now rewritten) responses.
pkill -f background_traffic.py 2>/dev/null || true
pkill -f concierge_traffic.py 2>/dev/null || true
if ! pgrep -f realchat_traffic.py > /dev/null; then
  nohup /opt/ld/ai-configs-intro/app/.venv/bin/python3 \
    /opt/ld/ai-configs-intro/traffic-generator/realchat_traffic.py \
    > /var/log/togglewear-realchat.log 2>&1 &
fi
exit 0
