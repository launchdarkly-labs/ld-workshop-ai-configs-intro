#!/bin/sh
# Coordinate ch10 solve: metric + the self-healing paste.
set -e
cd /opt/ld/ai-configs-intro/terraform/coordinate-10
echo "project_key = \"${LD_PROJECT_KEY}\"" > terraform.tfvars
terraform init -input=false
terraform apply -auto-approve
# ch10's block hooks into ch07's Concierge dispatch; make sure it's there.
python3 /opt/ld/ai-configs-intro/terraform/coordinate-07/patch-server.py
python3 /opt/ld/ai-configs-intro/terraform/coordinate-10/patch-server.py
service togglewear restart
pkill -f concierge_traffic.py 2>/dev/null || true
pkill -f background_traffic.py 2>/dev/null || true
if ! pgrep -f realchat_traffic.py > /dev/null; then
  nohup /opt/ld/ai-configs-intro/app/.venv/bin/python3 \
    /opt/ld/ai-configs-intro/traffic-generator/realchat_traffic.py \
    > /var/log/togglewear-realchat.log 2>&1 &
fi
exit 0
